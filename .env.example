NODE_ENV=development
PORT=3002
PUBLIC_BASE_URL=http://localhost:3002

# Logging: error | warn | info | debug (defaults: production=info, else debug)
LOG_LEVEL=
# Include stack traces in serialized errors (default: true in non-production)
LOG_STACK=

# Persistence: mongo today; switch implementation in src/data/repositories/index.js when adding postgres.
DB_DRIVER=mongo

MONGO_URI=mongodb://127.0.0.1:27017/arautomation
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PASSWORD_MIN_LENGTH=8
DISABLE_WORKERS=false

TRUST_PROXY=false
CORS_ORIGIN=*
CORS_CREDENTIALS=false
REQUEST_ID_HEADER=x-request-id
JSON_BODY_LIMIT=5mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# When false (default), unversioned /api/* mirrors /api/v1/* (except /api/files and /api/admin/*).
DISABLE_LEGACY_API_MOUNT=false

REDIS_QUEUE_PREFIX=
WORKER_AR_PROCESSING_ENABLED=true
WORKER_PDF_CREATION_ENABLED=true
WORKER_EMAIL_QUEUE_ENABLED=true

# Outbound SMTP (collection emails after PDF_GENERATED)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Email thread storage + sync (POST /api/v1/email/sync-thread/:arId, GET /api/v1/email/thread/:arId)
# Mailpit capture UI: http://localhost:8025 (scheme required; bare host:port is auto-prefixed with http://).
MAILPIT_HTTP_URL=
# Force IMAP sync even if MAILPIT_HTTP_URL is set
EMAIL_SYNC_FORCE_IMAP=false
# IMAP (Gmail: imap.gmail.com, port 993, IMAP_TLS=true). Falls back to SMTP_USER/SMTP_PASS when IMAP_* unset.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_AUTH_TIMEOUT=3000
# Dev / SSL-inspection only: set to false to skip TLS cert verification (prefer NODE_EXTRA_CA_CERTS for real fixes).
IMAP_TLS_REJECT_UNAUTHORIZED=true
IMAP_SINCE_DAYS=5
IMAP_SEARCH_ALL=false
IMAP_MAX_FETCH=200

# After merged PDF: enqueue SEND_EMAIL_JOB when recipient exists (customer.email or AR_COLLECTION_EMAIL_DEFAULT_TO)
AUTO_EMAIL_ON_PDF_GENERATED=true
# Fallback when AR has no company match and no guest email (Company.name is matched case-insensitively to AR companyName, then billingIdentifier)
AR_COLLECTION_EMAIL_DEFAULT_TO=
EMAIL_JOB_ATTEMPTS=3
EMAIL_JOB_BACKOFF_MS=5000

# Collection-email AI (OpenAI JSON). Falls back to template if disabled / fails.
AI_COLLECTION_EMAIL_ENABLED=true

BULL_BOARD_PATH=/api/admin/queues
BULL_BOARD_USERNAME=
BULL_BOARD_PASSWORD=
BULL_BOARD_READ_ONLY=false

# Ecobillz upstream API (posted AR rows, invoices list, cheque numbers per invoice)
ECOBILLZ_API_BASE_URL=http://localhost:4000/api/ar-automation
ECOBILLZ_AR_POSTED_ENTRIES_PATH=/ar-posted-entries
ECOBILLZ_INVOICES_PATH=/invoices
ECOBILLZ_GET_CHEQUES_PATH=/get-cheques
# Optional tenant defaults for outbound Ecobillz calls (24-char hex ObjectIds)
ECOBILLZ_MERCHANT_ID=
ECOBILLZ_OUTLET_ID=

DOCUMENTS_API_URL=

# OpenAI cover-letter refinement. Failsafe: if disabled, missing key, or call fails,
# the deterministic template is returned unchanged.
AI_COVER_LETTER_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=20000

# Cover letter template (PDF job → ai.service.generateCoverLetter). Override outlet / company lines per deployment.
# COVER_LETTER_TIMEZONE=Asia/Kolkata
COVER_LETTER_CUSTOMER_NO=
COVER_LETTER_COMPANY_NAME=
COVER_LETTER_COMPANY_ADDR_LINE1=
COVER_LETTER_COMPANY_ADDR_LINE2=
COVER_LETTER_COMPANY_ADDR_LINE3=
COVER_LETTER_COMPANY_ADDR_LINE4=
COVER_LETTER_COMPANY_PINCODE=
COVER_LETTER_ADDRESSED_TO=Accounts Department
COVER_LETTER_OUTLET_NAME=
COVER_LETTER_OUTLET_ADDRESS1=
COVER_LETTER_OUTLET_ADDRESS2=
COVER_LETTER_OUTLET_STATE=
COVER_LETTER_OUTLET_CITY=
COVER_LETTER_OUTLET_BANK_NAME=
COVER_LETTER_OUTLET_BANK_IFSC=
COVER_LETTER_OUTLET_BANK_ACCOUNT_PREFIX=
COVER_LETTER_OUTLET_PAN=
COVER_LETTER_OUTLET_GSTIN=
AR_INVOICE_DATE_PROXIMITY_DAYS=3
AR_DAILY_CRON=0 2 * * *
AR_DAILY_TZ=Asia/Kolkata
AR_DAILY_DISABLED=false
AR_DAILY_TARGETS=[]
AR_JOB_ATTEMPTS=3
AR_JOB_BACKOFF_MS=5000
PDF_JOB_ATTEMPTS=3
PDF_JOB_BACKOFF_MS=5000

# AR lifecycle timeline (`ArTracking` collection). Append-only events + SLA escalation helper.
TRACKING_RESPONSE_SLA_DAYS=7

STORAGE_DIR=/home/abhilash/Ecobillz/tmp/ar
